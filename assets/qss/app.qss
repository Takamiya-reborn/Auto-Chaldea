/* ==== Auto-Chaldea · FGO 游戏风主题 ==== */

/* ==== 字体与基底 ==== */
* {
    font-family: "Microsoft YaHei UI", "PingFang SC", sans-serif;
    font-size: 13px;
}

QWidget { color: #eedb5a; }
QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #7ba9ba, stop:0.1 #719bb0, stop:0.2 #688ea6,
        stop:0.3 #60839c, stop:0.4 #597994, stop:0.5 #54718d,
        stop:0.6 #50708f, stop:0.7 #4b7395, stop:0.8 #47769c,
        stop:0.9 #4279a0, stop:1 #3d76a2);
}
QWidget#centralCanvas {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #7ba9ba, stop:0.1 #719bb0, stop:0.2 #688ea6,
        stop:0.3 #60839c, stop:0.4 #597994, stop:0.5 #54718d,
        stop:0.6 #50708f, stop:0.7 #4b7395, stop:0.8 #47769c,
        stop:0.9 #4279a0, stop:1 #3d76a2);
}

/* ==== 提示气泡 ==== */
QToolTip {
    background-color: #10233a;
    color: #eedb5a;
    border: 1px solid #b89a5e;
    padding: 2px 6px;
    font-size: 11px;
}

/* ==== 活动栏 ==== */
#activityBar {
    background-color: rgba(255, 255, 255, 0.25);
    border-right: 1px solid rgba(255, 255, 255, 0.45);
}
QToolButton#activityButton {
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    padding: 2px 8px;
    color: #2c3a57;
    font-size: 11px;
    font-weight: 700;
}
QToolButton#activityButton:hover { background-color: rgba(255, 255, 255, 0.35); }
QToolButton#activityButton:checked {
    border-left: 3px solid #dac254;
    color: #eedb5a;
}

/* ==== 侧栏面板 ==== */
#sidePanel {
    background-color: rgba(255, 255, 255, 0.25);
    border-right: 1px solid rgba(255, 255, 255, 0.45);
}
QLabel#panelHeader {
    color: #dac254;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
}
QToolButton#panelHeaderButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px;
}
QToolButton#panelHeaderButton:hover { background-color: rgba(35, 64, 92, 0.7); }

/* ==== 列表与树（FGO 奶油卡片风）==== */
QListWidget, QTreeWidget { background: transparent; border: none; outline: none; }
/* 任务树的奶油卡片背景由 TaskTreeWidget.drawRow 整行自绘，不走 QSS */
QListWidget::item {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f7f2e4, stop:1 #eee5cd);
    border: 1px solid #b89a5e;
    border-radius: 6px;
    padding: 6px 8px;
    color: #61594d;
    font-weight: 700;
}
QListWidget::item:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #fdfaf0, stop:1 #f4ecd8);
    border-color: #c9a75f;
}
QListWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #fffdf4, stop:1 #f6edd6);
    border: 2px solid #d4b06a;
    padding: 5px 7px;
    color: #2c3a57;
}
QTreeWidget::branch { background: transparent; image: none; }
QTreeWidget { font-size: 12px; color: #61594d; font-weight: 700; }

/* ==== 详情区 ==== */
QLabel#detailTitle { font-size: 18px; font-weight: 800; }
QLabel#previewName { color: #eedb5a; font-size: 14px; font-weight: 700; }
QLabel#previewInfo { color: #eedb5a; font-size: 12px; }
QLabel#detailMeta, QLabel#statusLabel, QLabel#portLabel { color: #eedb5a; font-size: 12px; }
QLabel#detailDesc { color: #eedb5a; }
QLabel#emptyHint { color: #eedb5a; font-size: 22px; font-weight: 600; }
QLabel#emptySubHint { color: #eedb5a; font-size: 13px; }

/* ==== 表格（奶油底，仿 FGO 列表）==== */
QTableWidget {
    background-color: #f7f2e4;
    alternate-background-color: #efe7d2;
    color: #2c3a57;
    border: 1px solid #b89a5e;
    border-radius: 6px;
    gridline-color: #ddd2b8;
    selection-background-color: #f6edd6;
    selection-color: #2c3a57;
    outline: none;
}
QTableWidget::item { padding: 4px 8px; border: none; }
QHeaderView::section {
    background-color: #23405c;
    color: #eedb5a;
    border: none;
    border-bottom: 2px solid #b89a5e;
    border-right: 1px solid #0e1a28;
    padding: 7px 8px;
    font-weight: 700;
}

/* ==== 操作栏与输入框 ==== */
#actionBar { background-color: transparent; border-top: 1px solid rgba(255, 255, 255, 0.45); }
QLineEdit {
    background-color: #74736f;
    color: #e8e6df;
    font-weight: 700;
    border: 1px solid #3d5570;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #b8935a;
}
QLineEdit:focus { border: 1px solid #d4b06a; }

/* ==== 按钮（奶油底 + 金铜描边，FGO 菜单按钮风）==== */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #faf6ea, stop:1 #e8dfc8);
    color: #2c3a57;
    font-weight: 600;
    border: 2px solid #b89a5e;
    border-radius: 6px;
    padding: 6px 18px;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #fffdf4, stop:1 #efe6cf);
    border-color: #d4b06a;
}
QPushButton:pressed { background: #ddd2b4; border-color: #8a6f3c; }
QPushButton:disabled {
    background: #6b7d90;
    color: #3d4d5e;
    border-color: #4d5c6b;
}

/* ==== 任务详情页按钮（白底金边胶囊，FGO 弹窗按钮风）==== */
QPushButton[pill="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ffffff, stop:0.55 #f7f5ec, stop:1 #e3ddc8);
    color: #2c3a57;
    font-weight: 700;
    border: 2px solid #dac254;
    border-radius: 16px;
    padding: 5px 14px;
    min-width: 40px;
    min-height: 18px;
}
QPushButton[pill="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ffffff, stop:0.55 #fbf9f1, stop:1 #ece7d4);
    border-color: #eedb5a;
}
QPushButton[pill="true"]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #efe9d6, stop:1 #ddd5bc);
    border-color: #b3973c;
}
QPushButton[pill="true"]:disabled {
    background: #6b7d90;
    color: #3d4d5e;
    border-color: #4d5c6b;
}

/* ==== 连接设备对话框（浅蓝渐变，FGO 弹窗风）==== */
QDialog#connectDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #7ba9ba, stop:0.1 #719bb0, stop:0.2 #688ea6,
        stop:0.3 #60839c, stop:0.4 #597994, stop:0.5 #54718d,
        stop:0.6 #50708f, stop:0.7 #4b7395, stop:0.8 #47769c,
        stop:0.9 #4279a0, stop:1 #3d76a2);
}
/* ==== 执行次数对话框 ==== */
QDialog#runCountDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #7ba9ba, stop:0.1 #719bb0, stop:0.2 #688ea6,
        stop:0.3 #60839c, stop:0.4 #597994, stop:0.5 #54718d,
        stop:0.6 #50708f, stop:0.7 #4b7395, stop:0.8 #47769c,
        stop:0.9 #4279a0, stop:1 #3d76a2);
}
QLineEdit#countValue {
    font-size: 32px;
    font-weight: 800;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 6px;
    padding: 2px 4px;
    selection-background-color: #b8935a;
}
QLineEdit#countValue:focus { border: 1px solid #d4b06a; }
QPushButton#stepperButton {
    font-size: 22px;
    font-weight: 800;
    padding: 2px;
}
/* ==== 滚动条 / 分割线 ==== */
/* 滚动条由 HexScrollBar 全自绘（透明轨道 + 六边形手柄），不走 QSS */
QSplitter::handle { background-color: rgba(255, 255, 255, 0.4); }
QSplitter::handle:hover { background-color: #dac254; }
QStackedWidget { background: transparent; }
